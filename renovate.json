{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>tuxcrate/renovate-config:images"],
  "packageRules": [
    {
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["Prowlarr/Prowlarr"],
      "extractVersion": "^v(?<version>[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+)$",
      "versioning": "loose",
      "ignoreUnstable": true,
      "respectLatest": true
    }
  ]
}
